{
  "name": "api",
  "version": "1.0.0",
  "description": "Real-time transit tracking API — GTFS-RT polling, WebSocket broadcasting",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && npm run copy:proto",
    "copy:proto": "cp src/poller/gtfs-realtime.proto dist/poller/gtfs-realtime.proto",
    "start": "node dist/server.js",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run",
    "test:watch": "vitest --coverage",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": {
    "name": "Roaming Eclipse LLC"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "protobufjs": "^8.3.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.4.0",
    "globals": "^17.7.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^5.0.3"
  }
}
